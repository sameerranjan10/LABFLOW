# LabFlow Backend Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://labflow_user:labflow_password@localhost:5432/labflow_db
# For SQLite fallback during local testing without PostgreSQL:
# DATABASE_URL=sqlite:///./labflow.db

# JWT Security
JWT_SECRET=super_secret_jwt_key_change_me_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS Configuration
FRONTEND_URL=http://localhost:3000
